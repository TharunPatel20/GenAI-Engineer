# Copy this file to .env and replace the value with your own key.
# Get a free key from Google AI Studio (aistudio.google.com, "Get API key").
# Never share your key or commit .env to version control.
GEMINI_API_KEY=your-key-here

# Optional: choose a different model. Model names change, so check AI Studio.
# GEMINI_MODEL=gemini-2.5-flash
